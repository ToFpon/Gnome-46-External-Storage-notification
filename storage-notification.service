[Unit]
Description=Notification au branchement d'un stockage externe (clé, disque, carte SD, téléphone)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/storage-notification.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
